# Copy to .env.local and fill in from `supabase status` (local) or your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API key for AI follow-up messages (console.anthropic.com). Server-only: no NEXT_PUBLIC_ prefix.
# Leave empty to use simple English templates instead.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# The product's domain. Clubs live at <slug>.ROOT_DOMAIN and share one sign-in.
# Production: courtix.app. Local: courtix.localhost (open http://raccoon.courtix.localhost:3000 in Chrome).
ROOT_DOMAIN=courtix.localhost
